{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homeschool-hub",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homeschool-hub-db"
    }
  ]
}
